# Model weights go through Git LFS (GitHub rejects files > 100 MB; encoder ≈ 187 MB, Uni-Sign base ≈ 361 MB).
# One-time per clone:  git lfs install
models/*.pt filter=lfs diff=lfs merge=lfs -text
models/*.npz filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pt filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pth filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.onnx filter=lfs diff=lfs merge=lfs -text
artifacts/eval/*.npz filter=lfs diff=lfs merge=lfs -text
models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
models/**/*.task filter=lfs diff=lfs merge=lfs -text
# reverse part: the motion library (q.bin ≈ 200 MB) and the avatars
reverse_text2sign/models/motion/*.bin filter=lfs diff=lfs merge=lfs -text
reverse_text2sign/models/*.vrm filter=lfs diff=lfs merge=lfs -text
reverse_text2sign/vrm/*.vrm filter=lfs diff=lfs merge=lfs -text

# Experiment model weights and binary arrays
Boom/**/*.pt filter=lfs diff=lfs merge=lfs -text
Boom/**/*.pth filter=lfs diff=lfs merge=lfs -text
Boom/**/*.onnx filter=lfs diff=lfs merge=lfs -text
Boom/**/*.npz filter=lfs diff=lfs merge=lfs -text
Boom/**/*.npy filter=lfs diff=lfs merge=lfs -text
Boom/**/*.task filter=lfs diff=lfs merge=lfs -text
